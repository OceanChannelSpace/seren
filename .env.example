# SEREN MVP — environment variables
# Copy to .env (optional — every variable has a sane default).
# There are no secrets in this application.

# Port the web server listens on (default: 3000)
PORT=3000

# Filesystem path of the SQLite database file (default: ./data/seren.db)
DB_PATH=./data/seren.db

# Seed the demo community on first database creation: "true" or "false" (default: true)
SEED_DEMO=true

# Product name and tagline shown in the UI and at GET /api/meta.
# The name is provisional — keep branding out of technical namespaces.
# The on-disk storage prefix stays "seren" so members keep sessions on rename.
BRAND_NAME=SEREN
BRAND_TAGLINE=A consent-first space for meaningful connection

# Private beta gate: when set to a non-empty value, every /api/* route except
# /api/health and the beta endpoints requires visitors to enter this invite
# code once (stored in an HttpOnly cookie). Leave empty/unset for open access.
# Set this in your hosting provider's environment variables for the beta.
BETA_CODE=
